# Local Codex/Claude capability links are environment-owned, not project source.
.agents/
.claude/
.codex/
.local/

# Generated JavaScript and local dependency tree.
node_modules/
dist/

# Operator-local credentials and environment configuration.
.env
.env.*
!.env.example

# Product run bundles are immutable evidence outputs, not source.
artifacts/

# Local beads runtime data is handled separately after `bd init`.
.beads/*.db
.beads/*.db-shm
.beads/*.db-wal

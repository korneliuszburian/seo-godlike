# seo-godlike operator configuration
# Copy to .env locally, then fill values. Never commit .env or paste secrets into chat.

# Google OAuth client metadata.
# The existing CLI reads client_id/client_secret from this downloaded JSON.
GOOGLE_OAUTH_CLIENT_JSON_PATH=/home/krn/Downloads/client_secret_*.json

# The application uses this keyring reference for the refresh token.
GOOGLE_REFRESH_TOKEN_STORE=keyring:seo-godlike/google-agency-refresh-token

# Google Search Console / GA4 report defaults.
SEO_GODLIKE_CLIENT_ID=bodymove
SEO_GODLIKE_GSC_PROPERTY_ID=sc-domain:bodymove.pl
# Set only after an operator verifies the numeric GA4 property and capability.
SEO_GODLIKE_GA4_PROPERTY_ID=
SEO_GODLIKE_REGISTRY=fixtures/client-registry.json
SEO_GODLIKE_CAPABILITIES=fixtures/capability-registry.json
SEO_GODLIKE_ARTIFACTS_DIR=artifacts/analysis

# Localo MCP connection metadata.
LOCALO_MCP_URL=https://api.localo.com/api/mcp
# The current discovery adapter only needs this keyring reference.
LOCALO_MCP_TOKEN_STORE=keyring:seo-godlike/localo-mcp-token

# Ahrefs API metadata.
AHREFS_API_BASE_URL=https://api.ahrefs.com/v3
AHREFS_TARGET=bodymove.pl
AHREFS_DATE=
AHREFS_API_KEY_STORE=keyring:seo-godlike/ahrefs-api-key

# Codex SDK uses the local Codex login/runtime. Do not add OPENAI_API_KEY or
# CODEX_API_KEY here; the repository adapter intentionally strips both.
CODEX_WORKING_DIRECTORY=/absolute/path/to/seo-godlike
